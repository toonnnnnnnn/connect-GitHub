# Copy this file to server/.env and fill in your own key.
# server/.env is gitignored — never commit your real key.

OPENAI_API_KEY=sk-your-key-here

# Optional overrides:
# TTS_SERVER_PORT=8787
# Comma-separated list of allowed browser origins:
# TTS_SERVER_ALLOWED_ORIGIN=http://localhost:5183,http://127.0.0.1:5183
